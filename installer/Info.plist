<?xml version="1.0" encoding="UTF-8"?>
<!--
  Template for "RA Plugin Manifest Editor.app"/Contents/Info.plist. There is
  no MSBuild-driven macOS app-bundling step (unlike Icon/ApplicationManifest
  on Windows -- see RAPluginManifestEditor.csproj), so macos-build.yml
  assembles the .app by hand from the publish output plus this file,
  substituting __VERSION__ for the csproj <Version>.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>RA Plugin Manifest Editor</string>
	<key>CFBundleDisplayName</key>
	<string>Six Walls — RA Plugin Manifest Editor</string>
	<key>CFBundleIdentifier</key>
	<string>com.sixwalls.rapluginmanifesteditor</string>
	<key>CFBundleVersion</key>
	<string>__VERSION__</string>
	<key>CFBundleShortVersionString</key>
	<string>__VERSION__</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleExecutable</key>
	<string>RAPluginManifestEditor</string>
	<key>CFBundleIconFile</key>
	<string>icon.icns</string>
	<key>LSMinimumSystemVersion</key>
	<string>11.0</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.developer-tools</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright © Six Walls</string>
</dict>
</plist>
