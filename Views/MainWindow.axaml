<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RAPluginManifestEditor.ViewModels"
        xmlns:models="using:RAPluginManifestEditor.Models"
        xmlns:conv="using:RAPluginManifestEditor.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="RAPluginManifestEditor.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1200" Height="800" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Title="RA Control — Plugin Manifest Editor">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Resources>
        <conv:CountToVisibleConverter x:Key="CountToVisible" />
        <!-- shared column layout for the plugin table header + rows -->
    </Window.Resources>

    <Panel>
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

            <!-- ===================== Header ===================== -->
            <Border Grid.Row="0" Background="{StaticResource BrushPanel}"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1"
                    Padding="20,14">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <TextBlock Text="RA Control" FontWeight="Bold" FontSize="16"
                                   Foreground="{StaticResource BrushGold}" />
                        <TextBlock Text="Plugin Manifest Editor" FontWeight="Bold" FontSize="16" />
                        <TextBlock Text="edits HostMode.props (KnownPluginList)" FontSize="12"
                                   Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Grid.Column="1" Command="{Binding OpenHistoryCommand}" Classes="ghost" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Removal history" />
                            <Border Classes="chip-history" IsVisible="{Binding HistoryItems.Count, Converter={StaticResource CountToVisible}}">
                                <TextBlock Text="{Binding HistoryItems.Count}" />
                            </Border>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Content="Settings" Classes="ghost" Command="{Binding OpenSettingsCommand}" Margin="0,0,8,0" />
                    <Button Grid.Column="3" Content="?" Classes="icon-circle" Command="{Binding OpenHelpCommand}"
                            ToolTip.Tip="Help" />
                </Grid>
            </Border>

            <!-- ===================== Toolbar ===================== -->
            <Border Grid.Row="1" Background="{StaticResource BrushPanel}"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1"
                    Padding="20,10">
                <WrapPanel VerticalAlignment="Center" ItemSpacing="8" LineSpacing="8">
                    <Button Content="Open different file…" Classes="primary" Command="{Binding OpenFileCommand}" />
                    <Button Content="Reload from disk" IsEnabled="{Binding IsFileLoaded}" Command="{Binding ReloadFromDiskCommand}" />
                    <TextBox Text="{Binding SearchText}" PlaceholderText="Filter by name, manufacturer, format, category…"
                              IsEnabled="{Binding IsFileLoaded}" Width="320" />
                    <ComboBox ItemsSource="{Binding Formats}" SelectedItem="{Binding SelectedFormat}"
                              IsEnabled="{Binding IsFileLoaded}" MinWidth="140" />
                    <Button IsEnabled="{Binding IsFileLoaded}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding MapsButtonLabel}" />
                            <TextBlock Text="▾" Foreground="{StaticResource BrushTextMuted}" />
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                <MenuItem Header="{Binding CheckMapsMenuLabel}" Command="{Binding CheckMapAvailabilityCommand}"
                                          ToolTip.Tip="Cross-checks each plugin's uniqueId against RA Control's own local map cache (AvailableMaps.txt + Host Maps). Makes no network requests. Plugins with no map available anywhere are auto-checked for removal." />
                                <MenuItem Header="{Binding DownloadMapsProgressLabel, FallbackValue='Download all maps', TargetNullValue='Download all maps'}"
                                          IsVisible="{Binding CanLiveCheck}" Command="{Binding DownloadAllMapsCommand}"
                                          ToolTip.Tip="Downloads a real Mapping for every plugin marked 'Missing' and writes it to RA Control's own Host Maps folder — the same place its own Download button writes to." />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </WrapPanel>
            </Border>

            <!-- ===================== Status bar ===================== -->
            <Border Grid.Row="2" IsVisible="{Binding IsFileLoaded}"
                    Background="{StaticResource BrushPanel}"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1"
                    Padding="20,8">
                <Grid ColumnDefinitions="*,Auto">
                    <WrapPanel Grid.Column="0" ItemSpacing="18" LineSpacing="4" VerticalAlignment="Center">
                        <TextBlock Foreground="{StaticResource BrushTextMuted}" FontSize="12">
                            <Run Text="Total: " /><Run Text="{Binding TotalCount}" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" />
                        </TextBlock>
                        <TextBlock Foreground="{StaticResource BrushTextMuted}" FontSize="12">
                            <Run Text="Shown: " /><Run Text="{Binding ShownCount}" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" />
                        </TextBlock>
                        <TextBlock Foreground="{StaticResource BrushTextMuted}" FontSize="12">
                            <Run Text="Checked: " /><Run Text="{Binding CheckedCount}" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" />
                        </TextBlock>
                        <TextBlock FontSize="12" Foreground="{StaticResource BrushGreen}" FontWeight="SemiBold"
                                   IsVisible="{Binding AutoCheckedCount, Converter={StaticResource CountToVisible}}">
                            <Run Text="{Binding AutoCheckedCount}" /><Run Text=" auto-selected from removal history" />
                        </TextBlock>
                        <TextBlock FontSize="12" Foreground="{StaticResource BrushRed}" FontWeight="SemiBold"
                                   IsVisible="{Binding RemovedThisSessionCount, Converter={StaticResource CountToVisible}}">
                            <Run Text="{Binding RemovedThisSessionCount}" /><Run Text=" removed this session (not yet saved)" />
                        </TextBlock>
                        <TextBlock FontSize="12" Foreground="{StaticResource BrushGold}" FontWeight="SemiBold"
                                   IsVisible="{Binding MapsMissingCount, Converter={StaticResource CountToVisible}}">
                            <Run Text="{Binding MapsMissingCount}" /><Run Text=" plugin(s) missing a map (auto-selected)" />
                        </TextBlock>
                    </WrapPanel>
                    <Button Grid.Column="1" Classes="outline-red" Command="{Binding RemoveCheckedCommand}" VerticalAlignment="Center">
                        <TextBlock>
                            <Run Text="Remove checked (" /><Run Text="{Binding CheckedCount}" /><Run Text=")" />
                        </TextBlock>
                    </Button>
                </Grid>
            </Border>

            <!-- ===================== Main content ===================== -->
            <Grid Grid.Row="3">

                <!-- Empty state -->
                <StackPanel IsVisible="{Binding !IsFileLoaded}" VerticalAlignment="Center"
                            HorizontalAlignment="Center" Spacing="10" MaxWidth="480">
                    <TextBlock Text="No file loaded yet." FontSize="15" HorizontalAlignment="Center" />
                    <TextBlock Text="Open the HostMode.props file from RA Control's Host Mode folder."
                               Foreground="{StaticResource BrushTextMuted}" FontSize="12.5"
                               HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                    <TextBlock Text="{Binding LastKnownFileHint, StringFormat='Last file not found: {0}'}"
                               IsVisible="{Binding HasLastKnownFileHint}"
                               Foreground="{StaticResource BrushRed}" FontSize="11.5"
                               HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                    <Button Content="Open HostMode.props…" Classes="primary" Command="{Binding OpenFileCommand}"
                            HorizontalAlignment="Center" Margin="0,10,0,0" />
                </StackPanel>

                <!-- Plugin table -->
                <Grid RowDefinitions="Auto,*" IsVisible="{Binding IsFileLoaded}">

                    <Border Grid.Row="0" Classes="tableHeader" Margin="20,12,20,0">
                        <Grid ColumnDefinitions="40,2*,150,80,150,90,130,3*">
                            <CheckBox Grid.Column="0" IsChecked="{Binding HeaderCheckState}"
                                      VerticalAlignment="Center" HorizontalAlignment="Center"
                                      ToolTip.Tip="Check/uncheck all currently filtered plugins" />
                            <Button Grid.Column="1" Classes="headerSort" Content="Name"
                                    Command="{Binding SortByCommand}" CommandParameter="Name" />
                            <Button Grid.Column="2" Classes="headerSort" Content="Manufacturer"
                                    Command="{Binding SortByCommand}" CommandParameter="Manufacturer" />
                            <Button Grid.Column="3" Classes="headerSort" Content="Format"
                                    Command="{Binding SortByCommand}" CommandParameter="Format" />
                            <Button Grid.Column="4" Classes="headerSort" Content="Category"
                                    Command="{Binding SortByCommand}" CommandParameter="Category" />
                            <Button Grid.Column="5" Classes="headerSort" Content="Version"
                                    Command="{Binding SortByCommand}" CommandParameter="Version" />
                            <TextBlock Grid.Column="6" Text="Map" />
                            <Button Grid.Column="7" Classes="headerSort" Content="File"
                                    Command="{Binding SortByCommand}" CommandParameter="FilePath" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Margin="20,0,20,20"
                            BorderBrush="{StaticResource BrushBorder}" BorderThickness="1,0,1,1">
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding FilteredPlugins}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:PluginEntry">
                                        <Border Classes="pluginRow" Classes.marked="{Binding IsChecked}">
                                            <Grid ColumnDefinitions="40,2*,150,80,150,90,130,3*">
                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked}"
                                                          VerticalAlignment="Center" />
                                                <Grid Grid.Column="1" ColumnDefinitions="*,Auto,Auto" VerticalAlignment="Center">
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Medium"
                                                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                                                    <Border Grid.Column="1" Classes="chip-history" Margin="6,0,0,0" IsVisible="{Binding FromHistory}"
                                                            ToolTip.Tip="Previously removed — auto-selected">
                                                        <TextBlock Text="history" />
                                                    </Border>
                                                    <Border Grid.Column="2" Classes="chip-history" Margin="6,0,0,0" IsVisible="{Binding IsMapNotAvailable}"
                                                            ToolTip.Tip="No map available upstream — auto-selected for removal">
                                                        <TextBlock Text="no map" />
                                                    </Border>
                                                </Grid>
                                                <TextBlock Grid.Column="2" Text="{Binding Manufacturer}"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <Border Grid.Column="3" Classes="chip" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Format}" />
                                                </Border>
                                                <TextBlock Grid.Column="4" Text="{Binding Category}"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                           Foreground="{StaticResource BrushTextMuted}" FontSize="12" />
                                                <TextBlock Grid.Column="5" Text="{Binding Version}"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                           Foreground="{StaticResource BrushTextMuted}" FontSize="12" />
                                                <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <CheckBox IsVisible="{Binding IsMapMissing}" IsChecked="{Binding IsSelectedForMap}"
                                                              ToolTip.Tip="Selected for a future map download" />
                                                    <Border Classes="chip" Classes.mapDownloaded="{Binding IsMapDownloaded}"
                                                            Classes.mapMissing="{Binding IsMapMissing}"
                                                            Classes.mapNotAvailable="{Binding IsMapNotAvailable}"
                                                            HorizontalAlignment="Left">
                                                        <TextBlock Text="{Binding MapStatusLabel}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Grid.Column="7" Text="{Binding FilePath}" ToolTip.Tip="{Binding FilePath}"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                           Foreground="{StaticResource BrushTextMuted}" FontSize="11"
                                                           FontFamily="Consolas,monospace" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>

            <!-- ===================== Footer ===================== -->
            <Border Grid.Row="4" Background="{StaticResource BrushPanel}"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0"
                    Padding="20,12">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Button Content="Save changes" Classes="primary" IsEnabled="{Binding IsFileLoaded}"
                                Command="{Binding SaveCommand}" />
                        <Button Content="Save edited copy as…" IsEnabled="{Binding IsFileLoaded}"
                                Command="{Binding SaveAsCopyCommand}" />
                        <TextBlock Text="{Binding StatusLog}" Foreground="{StaticResource BrushTextMuted}"
                                   FontSize="11.5" TextWrapping="Wrap" MaxWidth="520" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Six Walls maker's mark -->
                    <Button Grid.Column="2" Classes="ghost" Padding="6,4" Click="OnSixWallsClick"
                            ToolTip.Tip="A Six Walls application — sixwalls.net">
                        <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                            <Image Source="avares://RAPluginManifestEditor/Assets/six_walls_mark.png"
                                   Height="24" VerticalAlignment="Center" />
                            <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="Bold"
                                       LetterSpacing="2">
                                <Run Text="SIX " Foreground="{StaticResource BrushTextPrimary}" />
                                <Run Text="WALLS" Foreground="#E08A3C" />
                            </TextBlock>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- ===================== Removal history overlay ===================== -->
        <Border IsVisible="{Binding IsHistoryOpen}" Background="#AA0F1115">
            <Border Background="{StaticResource BrushPanel}" BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1" CornerRadius="10" Width="620" MaxHeight="620"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Border Grid.Row="0" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="18,14">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="Removal history — auto-selected on load"
                                       FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="Close" Classes="ghost" Command="{Binding CloseHistoryCommand}" />
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="1" Padding="18,4">
                        <ItemsControl ItemsSource="{Binding HistoryItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:HistoryEntry">
                                    <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="0,8">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" />
                                                    <Border Classes="chip"><TextBlock Text="{Binding Format}" /></Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Manufacturer}" FontSize="11.5"
                                                           Foreground="{StaticResource BrushTextMuted}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                <Button Content="Restore" Classes="outline-green"
                                                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RestoreHistoryItemCommand}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="Forget" Classes="ghost"
                                                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ForgetHistoryItemCommand}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Border Grid.Row="2" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0" Padding="18,12">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Button Grid.Column="0" Content="Clear all history" Classes="outline-red"
                                    Command="{Binding ClearHistoryCommand}" />
                            <TextBlock Grid.Column="2" Text="{Binding HistoryItems.Count, StringFormat='{}{0} item(s)'}"
                                       Foreground="{StaticResource BrushTextMuted}" FontSize="11.5" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Border>

        <!-- ===================== Settings overlay ===================== -->
        <Border IsVisible="{Binding IsSettingsOpen}" Background="#AA0F1115">
            <Border Background="{StaticResource BrushPanel}" BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1" CornerRadius="10" Width="440" MaxHeight="560"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="18,14">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="Settings" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="Close" Classes="ghost" Command="{Binding CloseSettingsCommand}" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="1" Spacing="12" Margin="18,14">
                        <TextBlock Text="Your RA Control device(s)" FontWeight="SemiBold" FontSize="12.5" />
                        <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource BrushTextMuted}">
                            RA Control's map cache is organized per controller model — a map listed for hardware
                            you don't own won't actually be offered by RA Control. Select what you have so
                            "Check for missing maps" only flags maps that apply to you.
                        </TextBlock>

                        <StackPanel IsVisible="{Binding !HasKnownControllerModels}" Spacing="4">
                            <TextBlock Text="No device list found yet." FontWeight="SemiBold" FontSize="12.5" />
                            <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource BrushTextMuted}"
                                       Text="Open Host Mode in RA Control at least once so it can build AvailableMaps.txt, then reopen Settings." />
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding ControllerModelOptions}" IsVisible="{Binding HasKnownControllerModels}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:ControllerModelOption">
                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Margin="0,4" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,12,0,0"
                                IsVisible="{Binding CanConfigureLiveToken}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Live availability check (optional)" FontWeight="SemiBold" FontSize="12.5" />
                                <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource BrushTextMuted}">
                                    This app ships with no API access of its own. If you have your own token for
                                    RA Control's API, paste it here to enable a live check that re-verifies
                                    plugins the local cache couldn't confidently resolve. Entirely optional —
                                    everything else works without it.
                                </TextBlock>
                                <TextBox Text="{Binding ApiToken}" PlaceholderText="API token (optional)" PasswordChar="•" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <!-- ===================== Help overlay ===================== -->
        <Border IsVisible="{Binding IsHelpOpen}" Background="#AA0F1115">
            <Border Background="{StaticResource BrushPanel}" BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1" CornerRadius="10" Width="640" MaxHeight="700"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="18,14">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="Help" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="Close" Classes="ghost" Command="{Binding CloseHelpCommand}" />
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="1" Padding="18,14">
                        <StackPanel Spacing="16">

                            <Border Background="{StaticResource BrushPanelAlt}" BorderBrush="{StaticResource BrushBorder}"
                                    BorderThickness="1" CornerRadius="6" Padding="12,10">
                                <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource BrushTextMuted}">
                                    <Run FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Text="Unofficial, third-party tool." />
                                    <Run Text="This project is not created by, affiliated with, endorsed by, or sponsored by Rocksolid Audio. &quot;RA Control&quot; and any related names/marks belong to their respective owners and are used here only to describe compatibility. It works by editing a local config file (HostMode.props) and isn't supported by Rocksolid Audio — use at your own risk, and see &quot;Does it back up my file?&quot; below before relying on it." />
                                </TextBlock>
                            </Border>

                            <StackPanel Spacing="4">
                                <TextBlock Text="What this app does" FontWeight="SemiBold" FontSize="12.5" />
                                <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource BrushTextMuted}">
                                    RA Control keeps a list of every plugin it's found on your system in a file called
                                    HostMode.props — that's what populates the "Insert Plugins" list in Host Mode. This
                                    app gives you a proper interface for curating that list: remove clutter (duplicates,
                                    broken entries, plugins you don't use), and check which of your plugins already have
                                    a real control Mapping from RA Control versus which are still missing one.
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Getting started" FontWeight="SemiBold" FontSize="12.5" />
                                <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource BrushTextMuted}">
                                    Click "Open different file…" (or "Open HostMode.props…" if nothing's loaded) — the
                                    file picker opens straight into RA Control's own Host Mode folder, so just
                                    double-click HostMode.props. The app remembers the last file you opened and
                                    reloads it automatically next launch. "Reload from disk" re-reads the current file
                                    without reopening the picker — useful after RA Control's scanner has run again.
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Browsing and removing plugins" FontWeight="SemiBold" FontSize="12.5" />
                                <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource BrushTextMuted}">
                                    Filter by name, manufacturer, format, or category with the search box and format
                                    dropdown, or click any column header to sort. Check the plugins you want gone —
                                    the checkbox in the table header checks or unchecks every currently filtered row at
                                    once. Click "Remove checked (N)" to stage them for removal (nothing is written to
                                    disk yet), then "Save changes" to write it back to HostMode.props. If you still have
                                    plugins checked but never clicked "Remove checked," Save will stop and ask first, so
                                    you can't lose a batch of intended removals by accident. "Save edited copy as…"
                                    exports to a new file instead of overwriting the original.
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Removal history" FontWeight="SemiBold" FontSize="12.5" />
                                <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource BrushTextMuted}">
                                    Every plugin you remove is remembered even after you close the app. If RA Control's
                                    scanner ever re-adds a removed plugin, it's automatically pre-checked and tagged
                                    "history" next time you open or reload the file, so clearing it out again is just
                                    one more click. Open "Removal history" (next to Settings) to see everything you've
                                    ever removed — "Restore" puts a plugin straight back into the currently open file,
                                    "Forget" just stops it from being auto-selected without adding it back. Either way,
                                    click "Save changes" afterward to write it to disk.
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Checking for maps" FontWeight="SemiBold" FontSize="12.5" />
                                <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource BrushTextMuted}">
                                    The "Maps" menu in the toolbar cross-checks every plugin against RA Control's own
                                    local map cache — no network calls. Plugins with no map available anywhere get
                                    auto-checked for removal.
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Settings" FontWeight="SemiBold" FontSize="12.5" />
                                <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource BrushTextMuted}">
                                    Select which RA Control device(s) you own — the map cache is organized per
                                    controller model, so this scopes "missing map" checks to hardware you actually
                                    have.
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Does it back up my file?" FontWeight="SemiBold" FontSize="12.5" />
                                <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource BrushTextMuted}">
                                    Yes. Every time you click "Save changes," the app copies whatever is currently on
                                    disk to a timestamped backup (HostMode.props.bak-YYYYMMDD-HHmmss) in the same
                                    folder, before writing anything — automatically, every save, no setup required. If
                                    an edit goes wrong, the previous version is sitting right next to the file; just
                                    rename it back to HostMode.props. These backups accumulate over time and aren't
                                    auto-deleted, so it's worth clearing out old ones occasionally.
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Where things live" FontWeight="SemiBold" FontSize="12.5" />
                                <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource BrushTextMuted}">
                                    The manifest and its backups stay in RA Control's own Host Mode folder, untouched
                                    except when you hit Save. This app's own settings (last file, device selection)
                                    and removal history are stored separately, under
                                    %APPDATA%\RAPluginManifestEditor — deleting them resets this tool without touching
                                    RA Control itself.
                                </TextBlock>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Border>
    </Panel>

</Window>
