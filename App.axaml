<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RAPluginManifestEditor.App"
             Name="RA Plugin Manifest Editor"
             RequestedThemeVariant="Dark">

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://RAPluginManifestEditor/Styles/RATheme.axaml" />
    </Application.Styles>

</Application>
